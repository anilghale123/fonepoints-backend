# ─── Fonepoints Business backend ──────────────────────────────────────────────
# Copy to `.env` and fill in. Node loads it (`--env-file-if-exists`), and every
# value has a development default — see `src/config.ts`.

PORT=4000

# The Angular portal's origin. Allowed through CORS with credentials, so the
# session cookie travels. Never `*`: a wildcard cannot carry cookies, and would
# let any page spend the merchant's session.
PORTAL_ORIGIN=http://localhost:4200

# Where the OMS backend answers. Server to server; no browser calls it.
OMS_BASE_URL=http://localhost:3001

# The OMS company API key. MUST match OMS_COMPANY_API_KEY in `oms-backend`.
# This is the one real secret in this service: it stays in this process and is
# never sent to the portal frontend.
OMS_API_KEY=

# Session cookie flags. `lax` is right while the portal and this API share a
# site (localhost:4200 + localhost:4000 do; so do portal.fonepoints.com +
# api.fonepoints.com). Across registrable domains this must be `none`, which
# then also requires SESSION_SECURE=1 and HTTPS.
SESSION_SAMESITE=lax
SESSION_SECURE=0
