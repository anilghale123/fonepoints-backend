# ─── Fonepoints Business backend ──────────────────────────────────────────────
# Copy to `.env` and fill in. Node loads it (`--env-file-if-exists`). Every value
# except IAM_API_KEY has a development default — see `src/config.ts`.

PORT=4000

# The Angular portal's origin. Allowed through CORS with credentials, so the
# session cookie travels, and checked on POST /api/oms/token. Never `*`: a
# wildcard cannot carry cookies, and would let any page spend the session.
PORTAL_ORIGIN=http://localhost:4200

# Providhy IAM, which mints the merchant tokens OMS accepts. Server to server;
# no browser calls it. Development: https://dev-iam-api.providhy.com/
IAM_URL=https://dev-iam-api.providhy.com/

# The Providhy company API key (pk_…). The one real secret in this service: it
# stays in this process and is never sent to the portal frontend. Required —
# the service refuses to start without it. Ask the Providhy team for one.
IAM_API_KEY=

# Session cookie flags. `lax` is right while the portal and this API share a
# site (localhost:4200 + localhost:4000 do; so do portal.fonepoints.com +
# api.fonepoints.com). Across registrable domains this must be `none`, which
# then also requires SESSION_SECURE=1 and HTTPS.
SESSION_SAMESITE=lax
SESSION_SECURE=0
